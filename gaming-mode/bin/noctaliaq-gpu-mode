#!/usr/bin/env bash
# noctaliaq-gpu-mode — modo GPU: Hibrida (iGPU + dGPU offload) / Integrada
# (dGPU apagada por firmware).
#
# El cambio va por los atributos de firmware de asus-armoury, no por unbind
# del dispositivo PCI en vivo:
#
#   /sys/class/firmware-attributes/asus-armoury/attributes/dgpu_disable
#
# El firmware apaga la dGPU en el arranque, antes de que exista niri. Por eso
# TODO cambio requiere reinicio — es limitacion del firmware, igual que con
# rog-control-center.
#
# Precondicion critica para ir a Integrada: los modulos NVIDIA deben estar
# descargados al escribir el nodo. Con la sesion grafica viva el firmware
# rechaza con -EIO. De ahi el subcomando 'apply', que corre desde un TTY.
# Volver a Hibrida no tiene esa restriccion: en Integrada no hay modulos.
#
# Verificacion de tres puntos en cada escritura (codigo de salida, relectura,
# pending_reboot). El nodo MIENTE tras un write fallido: lee el valor nuevo
# aunque el firmware lo haya rechazado.
#
#   noctaliaq-gpu-mode              wizard interactivo
#   noctaliaq-gpu-mode status       estado (texto plano, una cosa por linea)
#   noctaliaq-gpu-mode integrated   registra la intencion + instrucciones
#   noctaliaq-gpu-mode hybrid       vuelve a Hibrida (directo, sin TTY)
#   noctaliaq-gpu-mode apply        ejecuta el cambio pendiente (desde TTY)
#
set -uo pipefail

P='\033[0;35m'; G='\033[0;32m'; Y='\033[1;33m'; R='\033[0;31m'
C='\033[0;36m'; D='\033[2m'; N='\033[0m'
log(){  echo -e "${P}[gpu]${N} $1"; }
# Rastro en el journal. Sin esto, un cambio de estado entre dos lecturas es
# imposible de reconstruir despues (paso el 2026-09-09).
jlog(){ command -v logger >/dev/null 2>&1 && logger -t noctaliaq-gpu-mode -- "$1"; }
ok(){   echo -e "${G}[+]${N} $1"; }
warn(){ echo -e "${Y}[i]${N} $1"; }
err(){  echo -e "${R}[x]${N} $1" >&2; }

ARMOURY=/sys/class/firmware-attributes/asus-armoury/attributes
DGPU_NODE="$ARMOURY/dgpu_disable/current_value"
DGPU_LEGACY=/sys/devices/platform/asus-nb-wmi/dgpu_disable
PENDING="$ARMOURY/pending_reboot"
[ -e "$DGPU_NODE" ] || DGPU_NODE="$DGPU_LEGACY"

# NO usar $HOME: bajo systemd no esta definido y con 'set -u' aborta el script
# en la primera linea que lo toque. /run es tmpfs (se limpia al reiniciar), que
# es justo la vida util correcta para una intencion pendiente de aplicar.
# /var/lib, no /run: el hook de apagado corre DESPUES de que /run pueda haberse
# limpiado, y la intencion tiene que sobrevivir hasta ese momento.
STATE_DIR=/var/lib/noctaliaq
INTENT="$STATE_DIR/gpu-mode-intent"

NV_MODULES=(nvidia_drm nvidia_modeset nvidia_uvm nvidia)

# ---------------------------------------------------------------- lectura ---

# Modo REAL: se infiere del hardware, no del nodo. El nodo dice que se aplicara
# en el proximo arranque; el hardware dice que hay ahora.
_modo_actual(){
    if [ -d /proc/driver/nvidia/gpus ] && \
       [ -n "$(ls -A /proc/driver/nvidia/gpus 2>/dev/null)" ]; then
        echo Hibrida; return
    fi
    lspci -nn 2>/dev/null | grep -qi 'nvidia' && echo Hibrida || echo Integrada
}

_modo_pendiente(){
    local v; v=$(cat "$DGPU_NODE" 2>/dev/null) || { echo '?'; return; }
    case "$v" in 0) echo Hibrida ;; 1) echo Integrada ;; *) echo '?' ;; esac
}

_modulos_cargados(){
    local m
    for m in "${NV_MODULES[@]}"; do
        lsmod 2>/dev/null | grep -q "^${m//-/_} " && return 0
    done
    return 1
}

_backlight_activo(){
    local b
    for b in /sys/class/backlight/*/; do
        [ -e "$b" ] && { basename "$b"; return 0; }
    done
    echo "(ninguno)"
}

_vatios(){
    local c v
    c=$(cat /sys/class/power_supply/BAT*/current_now 2>/dev/null | head -1) || return 1
    v=$(cat /sys/class/power_supply/BAT*/voltage_now 2>/dev/null | head -1) || return 1
    [ -n "$c" ] && [ -n "$v" ] || return 1
    awk -v c="$c" -v v="$v" 'BEGIN{ printf "%.2f", c*v/1e12 }'
}

_en_ac(){
    local p
    for p in /sys/class/power_supply/*/online; do
        [ -r "$p" ] && [ "$(cat "$p" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

_sesion_grafica(){ _modulos_cargados; }

# Una sola lectura consistente. El hardware puede cambiar entre dos llamadas
# sueltas (hotplug PCIe del firmware), asi que quien decide y quien pinta
# tienen que mirar la MISMA foto.
_estado(){ # imprime "actual|pendiente|modulos|lspci"
    local act pend mods n
    act=$(_modo_actual); pend=$(_modo_pendiente)
    _modulos_cargados && mods=si || mods=no
    n=$(lspci -nn 2>/dev/null | grep -ci nvidia)
    jlog "estado: actual=$act pendiente=$pend modulos=$mods lspci=$n"
    echo "$act|$pend|$mods|$n"
}

# --------------------------------------------------------------- escritura ---

# Verificacion de tres puntos. El nodo lee el valor nuevo aunque el firmware
# haya rechazado la escritura, asi que la relectura sola no prueba nada.
_escribir_dgpu(){ # $1 = 0|1
    local destino="$1" rc leido pend

    [ -e "$DGPU_NODE" ] || { err "No existe el nodo dgpu_disable — este equipo no expone asus-armoury."; return 1; }

    # Releer AQUI, no confiar en lo que se leyo al pintar el menu. Entre una
    # cosa y otra udev puede haber cargado los modulos tras un hotplug.
    if [ "$destino" = 1 ] && _modulos_cargados; then
        err "Los modulos NVIDIA estan cargados: el firmware rechazara el apagado."
        err "Corre esto desde un TTY con greetd parado ('noctaliaq-gpu-mode apply')."
        jlog "abortado: modulos cargados al momento de escribir destino=1"
        return 1
    fi

    jlog "escribiendo dgpu_disable=$destino (nodo lee $(cat "$DGPU_NODE" 2>/dev/null))"

    if [ "$(cat "$DGPU_NODE" 2>/dev/null)" = "$destino" ] && \
       [ "$(cat "$PENDING" 2>/dev/null || echo 0)" = "0" ]; then
        ok "El nodo ya esta en $destino y no hay nada encolado."
        return 0
    fi

    echo "$destino" | sudo tee "$DGPU_NODE" >/dev/null 2>&1
    rc=$?
    leido=$(cat "$DGPU_NODE" 2>/dev/null)
    pend=$(cat "$PENDING" 2>/dev/null || echo '?')

    if [ "$rc" -ne 0 ]; then
        err "El firmware rechazo la escritura (rc=$rc)."
        jlog "RECHAZO rc=$rc leido=$leido pending=$pend destino=$destino"
        warn "El nodo lee '$leido', pero eso NO significa que se haya aplicado."
        journalctl -k --since '1 min ago' --no-pager 2>/dev/null | grep -i armoury | tail -3
        _limpiar_nodo "$([ "$destino" = 1 ] && echo 0 || echo 1)"
        return 1
    fi

    if [ "$leido" != "$destino" ]; then
        err "Write aceptado pero el nodo lee '$leido' en vez de '$destino'."
        return 1
    fi

    if [ "$pend" = "0" ]; then
        err "Write aceptado y el nodo lee '$destino', pero pending_reboot sigue en 0."
        warn "El firmware no encolo el cambio. Reiniciar no serviria de nada."
        return 1
    fi

    ok "Escrito dgpu_disable=$destino  (pending_reboot=$pend)"
    jlog "OK dgpu_disable=$destino pending_reboot=$pend"
    return 0
}

# Tras un rechazo el nodo queda con el valor que no se aplico. Devolverlo a su
# valor real evita reiniciar con estado sucio.
_limpiar_nodo(){ # $1 = valor real
    echo "$1" | sudo tee "$DGPU_NODE" >/dev/null 2>&1 && \
        log "Nodo devuelto a $1 (estado real)."
}

_ofrecer_reboot(){
    [ -t 0 ] || { warn "Reinicia para aplicar."; return 0; }
    local r
    read -rp "  ¿Reiniciar ahora? [s/N] " r
    case "$r" in [sS]) log "Reiniciando..."; systemctl reboot ;;
                 *) warn "Cambio encolado; aplica en el proximo reinicio." ;; esac
}

# ------------------------------------------------------------- subcomandos ---

cmd_status(){
    local act pend bl w
    act=$(_modo_actual); pend=$(_modo_pendiente)
    if [ "$act" = "$pend" ]; then echo "Modo GPU:   $act"
    else echo "Modo GPU:   $act -> $pend (tras reinicio)"; fi
    echo "dgpu_disable: $(cat "$DGPU_NODE" 2>/dev/null || echo '?')"
    echo "pending_reboot: $(cat "$PENDING" 2>/dev/null || echo 'n/a')"
    echo "Modulos NVIDIA: $(_modulos_cargados && echo cargados || echo ninguno)"
    bl=$(_backlight_activo); echo "Backlight:  $bl"
    if [ "$act" = Integrada ] && [[ "$bl" != amdgpu_bl* ]]; then
        warn "En Integrada el backlight EC no mueve el panel."
        warn "Falta acpi_backlight=native en la cmdline (ver tools/ensure-backlight-native.sh)."
    fi
    _en_ac && echo "AC:         conectado" || echo "AC:         bateria"
    w=$(_vatios) && echo "Consumo:    ${w} W"
    [ -s "$INTENT" ] && echo "Intencion pendiente: $(cat "$INTENT")"
    return 0
}

cmd_integrated(){
    local act; act=$(_modo_actual)
    [ "$act" = Integrada ] && { ok "Ya estas en Integrada."; return 0; }

    if ! _sesion_grafica; then
        log "Sin modulos NVIDIA cargados — se puede aplicar aqui mismo."
        cmd_apply_now Integrada
        return $?
    fi

    sudo install -d -m 0755 "$STATE_DIR" && echo Integrada | sudo tee "$INTENT" >/dev/null
    [ -s "$INTENT" ] || { err "No se pudo registrar la intencion en $INTENT"; return 1; }
    echo ""
    warn "La dGPU quedara apagada: sin CUDA, sin PRIME offload."
    echo ""
    if systemctl is-enabled noctaliaq-gpu-apply.service >/dev/null 2>&1; then
        echo -e "  Se aplicara en el proximo apagado o reinicio."
    else
        echo -e "  El firmware rechaza el cambio mientras la sesion grafica tenga"
        echo -e "  los modulos NVIDIA. Hay que hacerlo desde un TTY:"
        echo ""
        echo -e "    ${C}1.${N} Cierra sesion."
        echo -e "    ${C}2.${N} ${C}Ctrl+Alt+F2${N} e inicia sesion en la consola."
        echo -e "    ${C}3.${N} ${C}noctaliaq-gpu-mode apply${N}"
    fi
    echo ""
    log "Intencion registrada. Nada se ha escrito todavia."

    if [ -t 0 ] && systemctl is-enabled noctaliaq-gpu-apply.service >/dev/null 2>&1; then
        echo ""
        echo -e "  El cambio se aplica solo durante el apagado, cuando ya no hay"
        echo -e "  sesion ni modulos cargados. ${D}No hace falta TTY.${N}"
        local r
        read -rp "  ¿Reiniciar ahora para aplicarlo? [s/N] " r
        case "$r" in
            [sS]) jlog "wizard: reiniciando con intencion Integrada"
                  systemctl reboot ;;
            *)    log "Se aplicara en el proximo reinicio." ;;
        esac
    fi
    return 0
}

cmd_hybrid(){
    local act; act=$(_modo_actual)
    [ "$act" = Hibrida ] && { ok "Ya estas en Hibrida."; sudo rm -f "$INTENT" 2>/dev/null || rm -f "$INTENT" 2>/dev/null; return 0; }
    # Volver no necesita TTY: en Integrada no hay modulos que descargar.
    _escribir_dgpu 0 || return 1
    sudo rm -f "$INTENT" 2>/dev/null || rm -f "$INTENT" 2>/dev/null
    ok "Modo GPU -> Hibrida. Reinicia para aplicar."
    _ofrecer_reboot
    return 0
}

# Escritura sin sesion grafica de por medio. No para greetd ni descarga nada:
# asume que ya no hay modulos.
cmd_apply_now(){ # $1 = Integrada|Hibrida
    local destino; [ "$1" = Integrada ] && destino=1 || destino=0
    _escribir_dgpu "$destino" || return 1
    sudo rm -f "$INTENT" 2>/dev/null || rm -f "$INTENT" 2>/dev/null
    ok "Modo GPU -> $1. Reinicia para aplicar."
    _ofrecer_reboot
    return 0
}

# En modo --system corre desde una unidad systemd: sin TTY, sin nadie mirando.
# Nunca pregunta, siempre deja rastro, y en cualquier fallo devuelve greetd.
_recuperar_greetd(){
    jlog "recuperando: systemctl start greetd"
    sudo systemctl start greetd 2>/dev/null || systemctl start greetd 2>/dev/null
}

# greetd lanza niri via PAM, no por el gestor de usuario de systemd: pararlo no
# se lleva el compositor por delante. Terminar el asiento si lo hace.
_terminar_sesiones(){
    local s_ leader
    for s_ in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$NF=="tty1" || $5=="user" {print $1}'); do
        jlog "terminando sesion $s_"
        loginctl terminate-session "$s_" 2>/dev/null
    done
    loginctl terminate-seat seat0 2>/dev/null
    sleep 2
    # Red final: cualquier niri que siga en pie tras terminar el asiento.
    for leader in $(pgrep -x niri 2>/dev/null); do
        jlog "niri $leader sigue vivo tras terminate-seat; SIGTERM"
        kill -TERM "$leader" 2>/dev/null
    done
    sleep 1
}

# greetd tarda en soltar los fds aunque systemd ya lo diera por parado.
_descargar_modulos(){ # $1 = intentos
    local i="${1:-10}" sudo_=""
    [ "$(id -u)" != 0 ] && sudo_=sudo
    while [ "$i" -gt 0 ]; do
        _modulos_cargados || { ok "Modulos fuera."; return 0; }
        $sudo_ modprobe -r "${NV_MODULES[@]}" 2>/dev/null && { ok "Modulos fuera."; return 0; }
        i=$((i-1)); sleep 1
    done
    err "No se pudieron descargar los modulos NVIDIA. Quien los retiene:"
    $sudo_ fuser -v /dev/nvidia* 2>&1 | sed 's/^/    /'
    jlog "fallo: modulos retenidos tras reintentos"
    return 1
}

# Corre desde ExecStop de la unidad, durante el apagado: greetd y niri ya estan
# abajo, journald sigue vivo y la raiz sigue escribible. Nunca reinicia (el
# apagado ya esta en curso) y nunca toca greetd (ya no existe).
cmd_apply_shutdown(){
    local objetivo
    objetivo=$(cat "$INTENT" 2>/dev/null)
    [ -n "$objetivo" ] || exit 0

    # journald se apaga antes de que terminemos: sus ultimas lineas se pierden.
    # La raiz sigue escribible en este punto, asi que el veredicto va a disco.
    LOG=/var/lib/noctaliaq/last-apply.log
    mkdir -p /var/lib/noctaliaq 2>/dev/null
    exec > >(while IFS= read -r l; do
                 printf '%s %s\n' "$(date '+%H:%M:%S')" "$l" | tee -a "$LOG"
             done) 2>&1
    echo "=== apply --shutdown $(date '+%Y-%m-%d %H:%M:%S') ==="

    echo "intencion: $objetivo"
    rm -f "$INTENT"

    local destino
    case "$objetivo" in
        Integrada) destino=1 ;;
        Hibrida)   destino=0 ;;
        *) echo "intencion desconocida, no se hace nada"; exit 0 ;;
    esac

    if _modulos_cargados; then
        echo "descargando modulos NVIDIA"
        modprobe -r "${NV_MODULES[@]}" 2>&1 || true
    fi
    if _modulos_cargados; then
        echo "los modulos siguen cargados; el firmware rechazara. Quien retiene:"
        fuser -v /dev/nvidia* 2>&1 || true
        exit 0
    fi

    local actual leido pend
    actual=$(cat "$DGPU_NODE" 2>/dev/null)
    if echo "$destino" > "$DGPU_NODE" 2>/dev/null; then
        leido=$(cat "$DGPU_NODE" 2>/dev/null)
        pend=$(cat "$PENDING" 2>/dev/null || echo '?')
        # Criterio: el write devolvio exito Y el nodo lee el destino. NO se
        # exige pending_reboot=1 aqui — se observo que al apagar puede quedar
        # en 0 aunque el cambio sea valido, y revertir por eso tiraba cambios
        # buenos. En el camino interactivo (_escribir_dgpu) si se exige, porque
        # ahi hay alguien mirando y el coste de un falso positivo es cero.
        if [ "$leido" = "$destino" ]; then
            echo "OK dgpu_disable=$destino (pending_reboot=$pend) -> $objetivo"
            [ "$pend" = 0 ] && echo "  nota: pending_reboot en 0; si al arrancar sigues en $actual, el firmware lo ignoro"
        else
            echo "RECHAZO leido=$leido pending=$pend; devolviendo a $actual"
            echo "$actual" > "$DGPU_NODE" 2>/dev/null
        fi
    else
        echo "el firmware rechazo la escritura; se queda en $actual"
        echo "$actual" > "$DGPU_NODE" 2>/dev/null
    fi
    echo "=== fin ==="
    exec >&- 2>&-
    wait
    exit 0
}

cmd_apply_system(){
    local objetivo
    objetivo=$(cat "$INTENT" 2>/dev/null)
    jlog "apply --system: intencion='$objetivo'"

    if [ "$objetivo" != Integrada ]; then
        err "Sin intencion 'Integrada' registrada (leido: '${objetivo:-vacio}'). No se hace nada."
        _recuperar_greetd
        return 1
    fi

    # Conflicts=greetd NO basta. greetd lanza niri por PAM, fuera del gestor de
    # usuario de systemd: parar la unidad deja el compositor huerfano, vivo, y
    # reteniendo /dev/nvidia*. Hay que terminar la sesion explicitamente.
    _terminar_sesiones

    _descargar_modulos 15 || { _recuperar_greetd; return 1; }

    if ! _escribir_dgpu 1; then
        err "El firmware rechazo el apagado. Se queda en Hibrida."
        _recuperar_greetd
        return 1
    fi

    sudo rm -f "$INTENT" 2>/dev/null || rm -f "$INTENT" 2>/dev/null
    ok "Modo GPU -> Integrada. Reiniciando..."
    jlog "exito: reiniciando para aplicar Integrada"
    systemctl reboot
    return 0
}

cmd_apply(){
    local objetivo m
    objetivo=$(cat "$INTENT" 2>/dev/null)
    [ -n "$objetivo" ] || { err "No hay ninguna intencion registrada. Corre 'noctaliaq-gpu-mode integrated' primero."; return 1; }
    log "Intencion registrada: $objetivo"

    if [ "$objetivo" = Hibrida ]; then cmd_apply_now Hibrida; return $?; fi

    if ! _sesion_grafica; then cmd_apply_now Integrada; return $?; fi

    if [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
        err "Esto corre desde un TTY, no desde la sesion grafica."
        err "Cierra sesion, Ctrl+Alt+F2, y vuelve a correrlo."
        return 1
    fi

    log "Parando greetd..."
    sudo systemctl stop greetd || { err "No se pudo parar greetd."; return 1; }
    sleep 2

    log "Descargando modulos NVIDIA..."
    if ! sudo modprobe -r "${NV_MODULES[@]}" 2>/dev/null; then
        err "No se pudieron descargar los modulos. Quien los retiene:"
        sudo fuser -v /dev/nvidia* 2>&1 | sed 's/^/    /'
        warn "Recupera con: sudo systemctl start greetd"
        return 1
    fi
    ok "Modulos fuera."

    if ! _escribir_dgpu 1; then
        warn "Recupera con: sudo systemctl start greetd"
        return 1
    fi

    sudo rm -f "$INTENT" 2>/dev/null || rm -f "$INTENT" 2>/dev/null
    ok "Modo GPU -> Integrada. Reinicia para aplicar."
    _ofrecer_reboot
    return 0
}

# ----------------------------------------------------------------- wizard ---

_pausa(){ echo ""; read -rsn1 -p "$(echo -e "  ${D}[cualquier tecla]${N}")"; echo ""; }

cmd_wizard(){
    [ -t 0 ] || { cmd_status; return 0; }
    local opt foto act pend mods g1 g2 m1 m2
    while true; do
        # Una sola foto por vuelta: el marcador y la accion miran lo mismo.
        foto=$(_estado)
        act=${foto%%|*}; foto=${foto#*|}
        pend=${foto%%|*}; foto=${foto#*|}
        mods=${foto%%|*}

        # El marcador va sobre el modo REAL, no sobre el pendiente. Confundir
        # los dos hace que el menu senale una fila y actue sobre otra.
        [ "$act" = Hibrida ]   && g1="●" || g1="○"
        [ "$act" = Integrada ] && g2="●" || g2="○"
        m1=""; m2=""
        [ "$pend" = Hibrida ]   && [ "$act" != Hibrida ]   && m1=" ${Y}⟳${N}"
        [ "$pend" = Integrada ] && [ "$act" != Integrada ] && m2=" ${Y}⟳${N}"

        printf '\033[2J\033[H'
        echo -e "  ${P}NoctaliaQ · Modo GPU${N}"
        echo -e "  ${D}──────────────────────────────────────────────${N}"
        echo -e "  Modo actual  ${C}${act}${N}   ${D}(● = activo ahora, ⟳ = tras reiniciar)${N}"
        [ "$act" != "$pend" ] && echo -e "  ${Y}Hay un cambio encolado: ${pend}${N}"
        [ "$mods" = si ] && echo -e "  ${D}modulos NVIDIA cargados${N}"
        echo ""
        echo -e "   ${g1} ${C}1${N}  Hibrida${m1}     ${D}iGPU + dGPU para offload: uso normal${N}"
        echo -e "   ${g2} ${C}2${N}  Integrada${m2}   ${D}dGPU apagada por firmware, ~3.8 W menos${N}"
        echo ""
        echo -e "     ${C}s${N}  Estado detallado"
        echo -e "     ${C}0${N}  Salir"
        echo ""
        read -rsn1 -p "$(echo -e "  ${P}>${N} ")" opt; echo ""
        case "$opt" in
            1) jlog "wizard: tecla 1 (Hibrida) con act=$act pend=$pend"; cmd_hybrid; _pausa ;;
            2) jlog "wizard: tecla 2 (Integrada) con act=$act pend=$pend"; cmd_integrated; _pausa ;;
            s|S) echo ""; cmd_status; _pausa ;;
            0|q|Q) printf '\033[2J\033[H'; return 0 ;;
        esac
    done
}

# ------------------------------------------------------------------ main ---

case "${1:-}" in
    status)                   cmd_status ;;
    integrated|integrada|igpu) cmd_integrated ;;
    hybrid|hibrida)           cmd_hybrid ;;
    apply)
        case "${2:-}" in
            --shutdown) cmd_apply_shutdown ;;
            --system)   cmd_apply_system ;;
            *)          cmd_apply ;;
        esac ;;
    --help|-h)
        echo "uso: noctaliaq-gpu-mode [status|integrated|hybrid|apply]"
        echo "  sin argumentos: wizard interactivo"
        echo "  apply --system: modo desatendido, para noctaliaq-gpu-apply.service" ;;
    "")                       cmd_wizard ;;
    *) err "opcion desconocida: $1"
       echo "uso: noctaliaq-gpu-mode [status|integrated|hybrid|apply]"; exit 1 ;;
esac
