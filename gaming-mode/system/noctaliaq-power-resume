#!/bin/sh
# /usr/lib/systemd/system-sleep/noctaliaq-power-resume
# La EC de ASUS vuelve al modo automatico al despertar: hay que reaplicar.
[ "$1" = "post" ] || exit 0
[ -x /usr/local/bin/noctaliaq-power ] || exit 0
NOCTALIAQ_POWER_CONF=/etc/noctaliaq/power.conf \
  /usr/local/bin/noctaliaq-power apply >/dev/null 2>&1
exit 0
