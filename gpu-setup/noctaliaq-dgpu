#!/usr/bin/env bash
# noctaliaq-dgpu: enciende/apaga la dGPU de un portatil hibrido con el mejor mecanismo disponible.
# Backends (se usa el primero que aplique; se puede forzar con BACKEND=... en /etc/noctaliaq/dgpu.conf):
#   firmware-asus  dgpu_disable de asus-nb-wmi: quita la dGPU del bus y la corta por firmware.
#   runtime-pm     generico: no la corta; deja el runtime PM en auto para que el kernel la suspenda
#                  cuando nadie la use. El ahorro real depende del driver y del firmware del equipo.
#   none           sin mecanismo: sale con 2 y el llamador sigue solo con estado.
# Corre como root: via pkexec (accion polkit org.noctaliaq.dgpu) o desde noctaliaq-dgpu-boot.service.
#   off | on | status | backend (imprime el backend elegido)
# Con firmware-asus, off sale con 3 sin tocar nada si algo usa la dGPU.
# Requiere niri con ignore-drm-device sobre la dGPU; si niri la abre, el apagado siempre da 3.
set -uo pipefail
SYS=${NOCTALIAQ_SYSFS:-/sys}
CONF=${NOCTALIAQ_CONF:-/etc/noctaliaq/dgpu.conf}
G=$SYS/devices/platform/asus-nb-wmi/dgpu_disable
TAG=noctaliaq-dgpu
BACKEND=auto
[[ -r $CONF ]] && source "$CONF"
log() { logger -t $TAG "$*"; echo "$*"; }

# --- dispositivos ---------------------------------------------------------
nv_devs() { for d in $SYS/bus/pci/devices/*; do [[ "$(cat "$d/vendor" 2>/dev/null)" == 0x10de ]] && echo "${d##*/}"; done; }
present() { [[ -n "$(nv_devs)" ]]; }
# GPUs que no son la de arranque (la dedicada), de cualquier fabricante
rpm_devs() {
  for d in $SYS/bus/pci/devices/*; do
    [[ "$(cat "$d/class" 2>/dev/null)" == 0x03* ]] || continue
    [[ "$(cat "$d/boot_vga" 2>/dev/null)" == 1 ]] && continue
    echo "${d##*/}"
  done
}

# --- backend firmware-asus (logica original) -------------------------------
fw_status() {
  if [[ "$(cat $G)" == 0 ]] && present; then echo on; else echo off; fi
}
fw_off() {
  if [[ "$(cat $G)" == 1 ]] && ! present; then exit 0; fi
  systemctl stop nvidia-powerd 2>/dev/null
  sleep 0.5
  EX=()
  for f in /dev/nvidia[0-9]* /dev/nvidiactl; do [[ -e $f ]] && EX+=("$f"); done
  for b in $(nv_devs); do for f in /dev/dri/by-path/pci-$b-*; do [[ -e $f ]] && EX+=("$f"); done; done
  H=""
  (( ${#EX[@]} )) && H=$(fuser "${EX[@]}" 2>/dev/null | tr -cs '0-9' '\n' | sort -u | tr '\n' ' ')
  if [[ -n "${H// }" ]]; then
    log "off pospuesto: dGPU en uso por$(for p in $H; do printf ' %s(%s)' "$(cat /proc/$p/comm 2>/dev/null)" "$p"; done)"
    exit 3
  fi
  for b in $(nv_devs | sort -r); do echo 1 > "$SYS/bus/pci/devices/$b/remove"; done
  sleep 1
  echo 1 > $G
  if present; then log "FALLO: la dGPU sigue en el bus"; exit 1; fi
  log "dGPU apagada (dgpu_disable=1)"
}
fw_on() {
  if [[ "$(cat $G)" == 0 ]] && present; then systemctl start nvidia-powerd 2>/dev/null; exit 0; fi
  echo 0 > $G
  sleep 1
  echo 1 > $SYS/bus/pci/rescan
  for i in 1 2 3 4 5; do present && break; sleep 1; done
  present || { log "FALLO: la dGPU no aparecio tras el rescan"; exit 1; }
  modprobe nvidia_drm 2>/dev/null
  systemctl start nvidia-powerd 2>/dev/null
  log "dGPU encendida (dgpu_disable=0)"
}

# --- backend runtime-pm (generico) ------------------------------------------
# runtime PM en auto para la GPU y sus funciones hermanas (audio HDMI, etc.)
rpm_auto() {
  local b f
  for b in $(rpm_devs); do
    for f in $SYS/bus/pci/devices/${b%.*}.*; do
      [[ -w $f/power/control ]] && echo auto > "$f/power/control"
    done
  done
}
rpm_status() {
  local b s
  b=$(rpm_devs | head -1)
  [[ -n $b ]] || { echo off; return; }
  s=$(cat "$SYS/bus/pci/devices/$b/power/runtime_status" 2>/dev/null)
  case "$s" in active|resuming) echo on ;; *) echo off ;; esac
}
rpm_off() {
  systemctl stop nvidia-powerd 2>/dev/null
  rpm_auto
  log "runtime-pm: dGPU en auto, el kernel la suspende cuando nadie la use"
}
rpm_on() {
  modprobe nvidia_drm 2>/dev/null
  rpm_auto
  systemctl start nvidia-powerd 2>/dev/null
  log "runtime-pm: dGPU disponible (auto)"
}

# --- eleccion de backend ------------------------------------------------------
detect() {
  case "$BACKEND" in firmware-asus|runtime-pm|none) echo "$BACKEND"; return ;; esac
  if [[ -e $G ]]; then echo firmware-asus
  elif [[ -n "$(rpm_devs)" ]]; then echo runtime-pm
  else echo none; fi
}
# en ASUS el modulo puede tardar unos segundos en exponer dgpu_disable
if [[ "$BACKEND" == firmware-asus ]] || grep -qi asus "$SYS/class/dmi/id/sys_vendor" 2>/dev/null; then
  for i in 1 2 3 4 5; do [[ -e $G ]] && break; sleep 1; done
fi
B=$(detect)
[[ "${1:-}" == backend ]] && { echo "$B"; exit 0; }
if [[ $B == none ]] || { [[ $B == firmware-asus ]] && [[ ! -e $G ]]; }; then
  echo "sin backend para la dGPU: no soportado"; exit 2
fi
case "${1:-}" in
  status) if [[ $B == firmware-asus ]]; then fw_status; else rpm_status; fi ;;
  off)    if [[ $B == firmware-asus ]]; then fw_off; else rpm_off; fi ;;
  on)     if [[ $B == firmware-asus ]]; then fw_on; else rpm_on; fi ;;
  *) echo "uso: noctaliaq-dgpu [on|off|status|backend]" >&2; exit 1 ;;
esac
