[Unit]
Description=NoctaliaQ: dGPU apagada fisicamente al arrancar
After=systemd-modules-load.service
Before=display-manager.service greetd.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/noctaliaq-dgpu off
RemainAfterExit=yes
ExecStop=-/usr/local/bin/noctaliaq-dgpu off
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
