#!/usr/bin/env bash
# noctaliaq-gpu-flatpak-sync — aplica a los flatpaks el estado de PRIME offload.
# Flatpak no hereda env vars del host: hay que fijarlas con `flatpak override --env=`.
#   on : variables de PRIME offload para TODOS los flatpaks (override global) y se
#        libera el ICD de Vulkan en los flatpaks Vulkan-nativos.
#   off: se quitan las variables y, en los Vulkan-nativos, se oculta el ICD de NVIDIA
#        para que el loader no despierte la dGPU. La ruta es la de DENTRO del sandbox
#        (radeon_icd.x86_64.json), no la del host.
set -uo pipefail
STATE=~/.local/state/noctaliaq/gpu-prime-state
VKAPPS=(org.vinegarhq.Sober)
VARS=(__NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME __VK_LAYER_NV_optimus)
if [[ -f "$STATE" ]] && [[ "$(cat "$STATE")" == "on" ]]; then
    flatpak override --user --env=__NV_PRIME_RENDER_OFFLOAD=1 \
        --env=__GLX_VENDOR_LIBRARY_NAME=nvidia \
        --env=__VK_LAYER_NV_optimus=NVIDIA_only 2>/dev/null
    for app in "${VKAPPS[@]}"; do
        flatpak override --user --unset-env=VK_ICD_FILENAMES "$app" 2>/dev/null
    done
    logger -t noctaliaq-gpu-flatpak-sync "PRIME on: dGPU visible para todos los flatpaks"
else
    for v in "${VARS[@]}"; do
        flatpak override --user --unset-env="$v" 2>/dev/null
    done
    for app in "${VKAPPS[@]}"; do
        flatpak override --user --env=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json "$app" 2>/dev/null
    done
    logger -t noctaliaq-gpu-flatpak-sync "PRIME off: ICD de NVIDIA oculto en flatpaks Vulkan"
fi
