#!/bin/bash
# noctaliaq-hwprobe: read-only report of the hybrid-GPU, power and fan mechanisms
# this machine offers. Works on any laptop; it never installs or changes anything.
#   noctaliaq-hwprobe            full probe
#   noctaliaq-hwprobe --report   same, with the dGPU state first (meant to be pasted in a bug report)
# NOCTALIAQ_SYSFS replaces /sys (used to test against a fake tree).
set -u
case "${1:-}" in
  "")        REPORT=0 ;;
  --report)  REPORT=1 ;;
  -h|--help) echo "usage: noctaliaq-hwprobe [--report]"; exit 0 ;;
  *)         echo "usage: noctaliaq-hwprobe [--report]" >&2; exit 2 ;;
esac
SYS=${NOCTALIAQ_SYSFS:-/sys}
rd() { if [ -r "$1" ]; then cat "$1" 2>/dev/null; else echo "-"; fi; }
sec() { printf '\n== %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1 && echo "yes" || echo "no"; }

WMI_ATTR=$SYS/devices/platform/asus-nb-wmi/dgpu_disable
ARMOURY_ATTR=$SYS/class/firmware-attributes/asus-armoury/attributes/dgpu_disable/current_value

# Is there an NVIDIA display controller (PCI class 0x03xx) on the bus? Same question as
# "lspci | grep -i nvidia", answered from sysfs so pciutils is not needed.
nvidia_visible() {
  local d
  for d in "$SYS"/bus/pci/devices/*; do
    [ "$(rd "$d/vendor")" = 0x10de ] || continue
    case "$(rd "$d/class")" in 0x03*) return 0 ;; esac
  done
  return 1
}

dgpu_state() {
  if [ -e "$WMI_ATTR" ]; then DGPU_ATTR=asus-nb-wmi; DGPU_DISABLE=$(rd "$WMI_ATTR")
  elif [ -e "$ARMOURY_ATTR" ]; then DGPU_ATTR=asus-armoury; DGPU_DISABLE=$(rd "$ARMOURY_ATTR")
  else DGPU_ATTR=none; DGPU_DISABLE=n/a; fi
  if nvidia_visible; then NV_VISIBLE=yes; else NV_VISIBLE=no; fi
  if [ -d "$SYS/module/nvidia" ] || [ -d "$SYS/module/nouveau" ]; then NV_DRIVER=yes; else NV_DRIVER=no; fi
  if [ "$NV_VISIBLE" = no ] && [ "$DGPU_DISABLE" = 1 ]; then NV_HIDDEN=yes; else NV_HIDDEN=no; fi
}

sec_dgpu_state() {
  sec "dGPU state"
  printf 'dgpu_disable              : %s\n' "$DGPU_DISABLE"
  printf 'dgpu_disable attribute    : %s\n' "$DGPU_ATTR"
  printf 'nvidia_visible            : %s\n' "$NV_VISIBLE"
  printf 'nvidia_driver_loaded      : %s\n' "$NV_DRIVER"
  printf 'nvidia_hidden_by_firmware : %s\n' "$NV_HIDDEN"
  if [ "$NV_HIDDEN" = yes ]; then
    printf '\nThe NVIDIA dGPU is powered off by firmware (dgpu_disable=1), so it is not on the PCI bus.\n'
    printf 'To power it on by hand, as root:\n\n'
    printf '  echo 0 > /sys/devices/platform/asus-nb-wmi/dgpu_disable && sleep 1 && echo 1 > /sys/bus/pci/rescan && modprobe nvidia_drm\n\n'
    printf 'NOT verified on the Odyssey kernel: the attribute may be the asus-armoury one instead:\n'
    printf '  /sys/class/firmware-attributes/asus-armoury/attributes/dgpu_disable/current_value\n'
  fi
}

echo "noctaliaq-hwprobe $(date +%F)"
dgpu_state
[ "$REPORT" = 1 ] && sec_dgpu_state

sec "Machine"
printf 'vendor : %s\nmodel  : %s\nkernel : %s\ninit   : %s\n' \
  "$(rd "$SYS/class/dmi/id/sys_vendor")" "$(rd "$SYS/class/dmi/id/product_name")" \
  "$(uname -r)" "$(ps -p 1 -o comm= 2>/dev/null || echo '?')"

sec "GPUs (PCI)"
for d in "$SYS"/bus/pci/devices/*; do
  [ -e "$d/class" ] || continue
  case "$(rd "$d/class")" in 0x03*) ;; *) continue ;; esac
  if [ -e "$d/driver" ]; then drv=$(basename "$(readlink -f "$d/driver")"); else drv="-"; fi
  printf '%s vendor=%s driver=%s boot_vga=%s control=%s runtime=%s d3cold=%s\n' \
    "$(basename "$d")" "$(rd "$d/vendor")" "$drv" "$(rd "$d/boot_vga")" \
    "$(rd "$d/power/control")" "$(rd "$d/power/runtime_status")" "$(rd "$d/d3cold_allowed")"
done
[ "$REPORT" = 0 ] && sec_dgpu_state

sec "Physical dGPU power-off: possible backends"
printf 'asus-armoury dgpu_disable : %s\n' "$([ -e "$ARMOURY_ATTR" ] && echo yes || echo no)"
printf 'asus-nb-wmi dgpu_disable  : %s\n' "$([ -e "$WMI_ATTR" ] && echo yes || echo no)"
printf 'firmware-attributes       : %s\n' "$(ls "$SYS/class/firmware-attributes" 2>/dev/null | tr '\n' ' ')"
for t in supergfxctl envycontrol optimus-manager system76-power prime-select; do
  printf '%-26s: %s\n' "$t" "$(have "$t")"
done

sec "NVIDIA"
printf 'nvidia module    : %s\n' "$(rd "$SYS/module/nvidia/version")"
printf 'nvidia-powerd    : %s\n' "$(systemctl list-unit-files nvidia-powerd.service 2>/dev/null | grep -c nvidia-powerd) unit(s)"
printf 'ACPI NVDA*       : %s\n' "$(ls "$SYS/bus/acpi/devices" 2>/dev/null | grep -E '^NVDA' | tr '\n' ' ')"
grep -hE 'DynamicPowerManagement' /proc/driver/nvidia/params 2>/dev/null
for g in /proc/driver/nvidia/gpus/*; do
  [ -e "$g/power" ] && { echo "[$(basename "$g")]"; sed -n '1,4p' "$g/power"; }
done

sec "Power profiles"
printf 'platform_profile : %s (choices: %s)\n' "$(rd "$SYS/firmware/acpi/platform_profile")" "$(rd "$SYS/firmware/acpi/platform_profile_choices")"
printf 'powerprofilesctl : %s (%s)\n' "$(have powerprofilesctl)" "$(powerprofilesctl get 2>/dev/null || echo -)"
printf 'tuned-adm        : %s\n' "$(have tuned-adm)"

sec "Fans (hwmon)"
for h in "$SYS"/class/hwmon/hwmon*; do
  [ -e "$h/name" ] || continue
  curve=""
  compgen -G "$h/pwm*_auto_point1_temp" >/dev/null && curve=" [editable curve]"
  printf '%s %s%s\n' "$(basename "$h")" "$(rd "$h/name")" "$curve"
done

sec "Battery"
for b in "$SYS"/class/power_supply/BAT*; do
  [ -e "$b" ] || continue
  printf '%s status=%s power_now=%s\n' "$(basename "$b")" "$(rd "$b/status")" "$(rd "$b/power_now")"
done
echo "(end of report)"
