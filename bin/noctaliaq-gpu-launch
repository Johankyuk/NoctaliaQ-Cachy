#!/usr/bin/env bash
# noctaliaq-gpu-launch — wrapper para launch_apps_custom_command.
# Si el estado es "on", antepone las vars de PRIME offload al comando real.
STATE=~/.local/state/noctaliaq/gpu-prime-state
if [[ -f "$STATE" ]] && [[ "$(cat "$STATE")" == "on" ]]; then
    exec env __NV_PRIME_RENDER_OFFLOAD=1 \
             __GLX_VENDOR_LIBRARY_NAME=nvidia \
             __VK_LAYER_NV_optimus=NVIDIA_only \
             DRI_PRIME=1 \
             "$@"
else
    exec "$@"
fi
