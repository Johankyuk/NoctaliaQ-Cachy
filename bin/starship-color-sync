#!/usr/bin/env bash
# starship-color-sync — recolorea toda la barra con primary de Noctalia (color plano, sin gradiente).
# Las 5 flechas y las 2 cápsulas se reescriben por POSICIÓN ESTRUCTURAL fija,
# nunca por el valor que tuvieran antes — así no se desincronizan entre corridas.
set -uo pipefail
PALETTE="$HOME/.cache/noctalia/palette-raw.conf"
CONF="$HOME/.config/starship.toml"
[ -r "$PALETTE" ] || { echo "no encontré $PALETTE" >&2; exit 1; }
[ -w "$CONF" ] || { echo "sin permiso de escritura en $CONF" >&2; exit 1; }

primary=$(grep -oP '(?<=^primary=)#[0-9a-fA-F]{6}' "$PALETTE" | head -1)
[ -n "$primary" ] || { echo "no pude leer primary de $PALETTE" >&2; exit 1; }

primary_upper=$(echo "${primary#\#}" | tr '[:lower:]' '[:upper:]')

cp "$CONF" "$CONF.bak.$(date +%s)"

python3 - "$CONF" "$primary_upper" <<'PYEOF'
import re, sys, pathlib

conf, primary = sys.argv[1], sys.argv[2]
p = pathlib.Path(conf)
text = p.read_text()

t_user = t_dir = t_git = t_lang = t_dock = t_time = primary

def sync_home(pattern, new_val):
    global text
    m = re.search(pattern, text, re.S)
    assert m, f"no encontré ancla: {pattern}"
    text = text.replace(m.group(1), f"#{new_val}")

sync_home(r'style_user = "bg:(#[0-9A-Fa-f]{6})"', t_user)
sync_home(r'\[directory\]\nstyle = "bg:(#[0-9A-Fa-f]{6})"', t_dir)
sync_home(r'\[git_branch\][^\[]*?style = "bg:(#[0-9A-Fa-f]{6})"', t_git)
sync_home(r'\[git_status\]\nstyle = "bg:(#[0-9A-Fa-f]{6})"', t_git)
sync_home(r'\[c\]\nsymbol[^\n]*\nstyle = "bg:(#[0-9A-Fa-f]{6})"', t_lang)
sync_home(r'\[docker_context\][^\[]*?style = "bg:(#[0-9A-Fa-f]{6})"', t_dock)
text = re.sub(r'(\[time\][^\[]*?style = "bg:)#[0-9A-Fa-f]{6}(")',
              lambda m: f'{m.group(1)}#{t_time}{m.group(2)}', text, flags=re.S)

# --- flechas y cápsulas: reescritura estructural, no depende de valores viejos ---
text = re.sub(r'^\[\]\(#[0-9A-Fa-f]{6}\)\\$',
              lambda m: f'[](#{t_user})\\', text, count=1, flags=re.M)
text = re.sub(r'^\[\]\(bg:#[0-9A-Fa-f]{6} fg:#[0-9A-Fa-f]{6}\)\\$',
              lambda m: f'[](bg:#{t_dir} fg:#{t_user})\\', text, count=1, flags=re.M)
seq = iter([(t_dir, t_git), (t_git, t_lang), (t_lang, t_dock), (t_dock, t_time)])
def repl_arrow(m):
    fg, bg = next(seq)
    return f'[](fg:#{fg} bg:#{bg})\\'
text = re.sub(r'^\[\]\(fg:#[0-9A-Fa-f]{6} bg:#[0-9A-Fa-f]{6}\)\\$', repl_arrow, text, flags=re.M)
text = re.sub(r'^\[ \]\(fg:#[0-9A-Fa-f]{6}\)\\$',
              lambda m: f'[ ](fg:#{t_time})\\', text, count=1, flags=re.M)

p.write_text(text)
print(f"paleta: user=#{t_user} dir=#{t_dir} git=#{t_git} lang=#{t_lang} docker=#{t_dock} time=#{t_time}")
PYEOF
echo "starship-color-sync: primary=#${primary_upper} -> color plano aplicado a las 6 paradas"
