#!/usr/bin/env bash
# starship-color-sync — recolorea TODA la barra de starship en tonos del accent_color de Noctalia
# (mismo hue, value progresivo oscuro->claro por segmento). Disparado por colors_changed.
set -uo pipefail
CSS="$HOME/.config/gtk-4.0/noctalia.css"
CONF="$HOME/.config/starship.toml"
[ -r "$CSS" ] || { echo "no encontré $CSS" >&2; exit 1; }
[ -w "$CONF" ] || { echo "sin permiso de escritura en $CONF" >&2; exit 1; }
hex=$(grep -oP '(?<=@define-color accent_color )#[0-9a-fA-F]{6}' "$CSS" | head -1)
[ -n "$hex" ] || { echo "no pude leer accent_color de $CSS" >&2; exit 1; }
hex_upper=$(echo "${hex#\#}" | tr '[:lower:]' '[:upper:]')
cp "$CONF" "$CONF.bak.$(date +%s)"
python3 - "$CONF" "$hex_upper" <<'PYEOF'
import re, sys, pathlib, colorsys

conf, accent = sys.argv[1], sys.argv[2]
p = pathlib.Path(conf)
text = p.read_text()

r = int(accent[0:2], 16) / 255
g = int(accent[2:4], 16) / 255
b = int(accent[4:6], 16) / 255
h, s, v = colorsys.rgb_to_hsv(r, g, b)

def tone(v_mult):
    vv = min(1.0, v * v_mult)
    rr, gg, bb = colorsys.hsv_to_rgb(h, s, vv)
    return f"{round(rr*255):02X}{round(gg*255):02X}{round(bb*255):02X}"

t_user, t_dir, t_git, t_lang, t_dock, t_time = (
    tone(0.55), tone(0.68), tone(0.80), tone(0.90), tone(1.00), accent
)

m_dir  = re.search(r'\[directory\]\nstyle = "bg:(#[0-9A-Fa-f]{6})"', text)
m_git  = re.search(r'\[git_branch\][^\[]*?style = "bg:(#[0-9A-Fa-f]{6})"', text, re.S)
m_lang = re.search(r'\[c\]\nsymbol[^\n]*\nstyle = "bg:(#[0-9A-Fa-f]{6})"', text)
m_dock = re.search(r'\[docker_context\][^\[]*?style = "bg:(#[0-9A-Fa-f]{6})"', text, re.S)
assert m_dir and m_git and m_lang and m_dock, "no encontré alguno de los anchors de color"
old_dir, old_git, old_lang, old_dock = m_dir.group(1), m_git.group(1), m_lang.group(1), m_dock.group(1)

# username/time: por campo, no por valor (ya pueden coincidir entre sí)
text = re.sub(r'(style_user = "bg:)#[0-9A-Fa-f]{6}(")', rf'\1#{t_user}\2', text)
text = re.sub(r'(style_root = "bg:)#[0-9A-Fa-f]{6}(")', rf'\1#{t_user}\2', text)
text = re.sub(r'(\[\]\()#[0-9A-Fa-f]{6}(\))', rf'\1#{t_user}\2', text, count=1)
text = re.sub(r'(\[time\].*?style = "bg:)#[0-9A-Fa-f]{6}(")', rf'\1#{t_time}\2', text, flags=re.S)

# resto: valores únicos todavía, replace directo cubre también las flechas
text = text.replace(old_dir, f"#{t_dir}")
text = text.replace(old_git, f"#{t_git}")
text = text.replace(old_lang, f"#{t_lang}")
text = text.replace(old_dock, f"#{t_dock}")

p.write_text(text)
print(f"paleta: user=#{t_user} dir=#{t_dir} git=#{t_git} lang=#{t_lang} docker=#{t_dock} time=#{t_time}")
PYEOF
echo "starship-color-sync: accent #${hex_upper} -> paleta completa aplicada"
